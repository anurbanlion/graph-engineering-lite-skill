#!/usr/bin/env sh

set -eu

SCRIPT_DIRECTORY=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_DIRECTORY=$(CDPATH= cd -- "$SCRIPT_DIRECTORY/.." && pwd)

if command -v node >/dev/null 2>&1; then
  exec node "$@"
fi

NVM_DIR=${NVM_DIR:-"$HOME/.nvm"}

if [ -s "$NVM_DIR/nvm.sh" ]; then
  # shellcheck disable=SC1090
  . "$NVM_DIR/nvm.sh"

  if [ -f "$REPOSITORY_DIRECTORY/.nvmrc" ]; then
    nvm use --silent >/dev/null
  elif nvm alias default >/dev/null 2>&1; then
    nvm use --silent default >/dev/null || true
  fi

  if command -v node >/dev/null 2>&1; then
    exec node "$@"
  fi
fi

for NODE_BINARY in "$NVM_DIR"/versions/node/*/bin/node; do
  if [ -x "$NODE_BINARY" ]; then
    exec "$NODE_BINARY" "$@"
  fi
done

echo "scripts/node: Node.js was not found in PATH or NVM" >&2
exit 127