#!/usr/bin/env python3
"""Temporary-file patch applicator for the experimental WSL Codex skill."""

from __future__ import annotations

import re
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
REPORTS = ROOT / ".patch-reports"
HUNK_HEADER = re.compile(r"^@@\s+(\d+)\s+(\d+)\s*$")


def fail(message: str, code: int = 2) -> int:
    print(message, file=sys.stderr)
    return code




def parse_temp(path: Path) -> list[tuple[int, int, list[str]]]:
    if not path.is_file():
        raise ValueError(f"Patch temp file not found: {path}")

    hunks: list[tuple[int, int, list[str]]] = []
    current: tuple[int, int, list[str]] | None = None
    for line in path.read_text(encoding="utf-8").splitlines():
        header = HUNK_HEADER.match(line)
        if header:
            if current is not None:
                hunks.append(current)
            current = (int(header.group(1)), int(header.group(2)), [])
            continue
        if current is None:
            if line.strip():
                raise ValueError("Patch temp must start each change with @@ start end.")
            continue
        current[2].append(line[1:] if line.startswith("+") else line)

    if current is not None:
        hunks.append(current)
    if not hunks:
        raise ValueError("Patch temp contains no hunks.")
    return hunks


def build_diff_report(target_path, hunks, original_lines):
    report_lines = [f"--- {target_path}", f"+++ {target_path}"]
    line_offset = 0
    for start, end, replacement in hunks:
        old_lines = original_lines[start - 1:end]
        new_start = start + line_offset
        report_lines.append(
            f"@@ -{start},{len(old_lines)} +{new_start},{len(replacement)} @@"
        )
        report_lines.extend("-" + line for line in old_lines)
        report_lines.extend("+" + line for line in replacement)
        line_offset += len(replacement) - len(old_lines)
    return "\n".join(report_lines) + "\n"


def apply_temp(temp_path: Path, target_path: Path) -> int:
    try:
        hunks = parse_temp(temp_path)
    except ValueError as error:
        return fail(str(error))

    if not target_path.is_file():
        return fail(f"Target file not found: {target_path}", 1)

    original = target_path.read_text(encoding="utf-8")
    lines = original.splitlines()
    had_trailing_newline = original.endswith("\n")
    previous_end = 0
    for start, end, _ in hunks:
        if start < 1 or end < start or end > len(lines):
            return fail(f"Invalid target range: {start}-{end}", 1)
        if start <= previous_end:
            return fail("Overlapping or unordered patch ranges.", 1)
        previous_end = end

    report_text = build_diff_report(target_path, hunks, lines)
    for start, end, replacement in reversed(hunks):
        lines[start - 1:end] = replacement

    updated = "\n".join(lines)
    if had_trailing_newline:
        updated += "\n"

    with tempfile.NamedTemporaryFile(
        "w", encoding="utf-8", dir=target_path.parent, delete=False
    ) as handle:
        handle.write(updated)
        temporary_target = Path(handle.name)
    temporary_target.replace(target_path)

    REPORTS.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    report = REPORTS / f"{timestamp}.patch"
    report.write_text(report_text, encoding="utf-8")
    try:
        temp_path.unlink()
    except OSError as error:
        return fail(f"Applied patch but could not remove {temp_path}: {error}", 1)
    print(f"Applied {len(hunks)} hunk(s) to {target_path}")
    print(f"Patch report: {report}")
    return 0


def main() -> int:
    if len(sys.argv) != 3:
        return fail("Usage: apply_patch patch.temp target")
    return apply_temp(Path(sys.argv[1]), Path(sys.argv[2]))


if __name__ == "__main__":
    raise SystemExit(main())